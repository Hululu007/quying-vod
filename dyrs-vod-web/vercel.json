{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "server.mjs": {
      "includeFiles": "public/**",
      "maxDuration": 60
    }
  },
  "headers": [
    { "source": "/app.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/styles.css", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/admin.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/admin.css", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/favicon.svg", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
