[project]
sub_id = "e6f311f5"
name = "dyrs-vod"
requires = ["python-3.12"]
project_type = "backend"
version = "0.1.9"
entrypoint = "app.py"

[preview]
preview_enable = "disabled"

[deploy]
build = ["bash", "dyrs-vod/scripts/setup.sh"]
run = ["bash", "dyrs-vod/scripts/http_run.sh", "-p", "5000"]
deps = ["git"]

[deploy.profile]
kind = "service"
flavor = "web"

[deploy.backend]
enabled = true

[subprojects]
path = ["dyrs-vod"]