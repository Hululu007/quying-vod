[project]
sub_id = "e6f311f5"
name = "dyrs-vod"
requires = ["nodejs20"]
project_type = "backend"
version = "1.0.0"
entrypoint = "dyrs-vod-web/server.mjs"

[preview]
preview_enable = "disabled"

[deploy]
build = ["bash", "dyrs-vod-web/build.sh"]
run = ["bash", "dyrs-vod-web/run.sh", "-p", "5000"]

[deploy.profile]
kind = "service"
flavor = "web"

[deploy.backend]
enabled = true
